<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.mybatis.example.EmpMapper">
  <!--쿼리 질의결과를 객체에 담아서 반환
  resultType - 이름만 적어도 됨
  -->
  <select id="selectEmp" resultType="ex05.dto.EmpDTO">
    select * from EMP
  </select>

  <!-- 동적쿼리 (#{} : 외부에서 가져옴) -->
  <select id = "selectOne" resultType = "ex05.dto.EmpDTO">
    SELECT * FROM EMP WHERE EMP_ID = #{empId}
  </select>

</mapper>